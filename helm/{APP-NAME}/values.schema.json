{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "externalDNSIP": {
            "type": "string"
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts and the platform.",
            "additionalProperties": true,
            "properties": {
                "podSecurityStandards": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "helm": {
            "type": "object",
            "additionalProperties": true
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "managementCluster": {
            "type": "string"
        },
        "provider": {
            "type": "string"
        },
        "registry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "domain": {
                    "type": "string"
                }
            }
        },
        "subscriptionID": {
            "type": "string"
        }
    }
}
